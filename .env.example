# EnterChat Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption Keys
ENCRYPTION_KEY=your_32_byte_encryption_key_here
ENCRYPTION_SALT=your_encryption_salt_here

# API Endpoints
API_BASE_URL=https://api.enterchat.com

# Web3 Configuration (for wallet features)
WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=1

# Push Notifications (optional)
FCM_SERVER_KEY=your_fcm_server_key

# OAuth (for platform integrations)
WHATSAPP_CLIENT_ID=your_whatsapp_client_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
